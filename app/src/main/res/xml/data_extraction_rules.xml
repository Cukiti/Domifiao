<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!--
    Configuración de extracción de datos segura (Android 12+)
    Excluye datos sensibles de backup en nube y transferencia entre dispositivos
    -->

    <cloud-backup>
        <!-- Incluir datos generales EXCEPTO sesión -->
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="domifiao_prefs.xml"/>

        <include domain="database" path="."/>
    </cloud-backup>

    <device-transfer>
        <!-- Transferencia entre dispositivos: excluir sesión también -->
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="domifiao_prefs.xml"/>

        <include domain="database" path="."/>
    </device-transfer>
</data-extraction-rules>